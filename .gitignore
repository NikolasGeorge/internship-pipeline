# Whitelist, not a blocklist.
#
# This directory is a live job search: it holds resume content, application
# history, fetched job descriptions, and generated documents. Enumerating
# those to exclude them means one new file type is one accidental commit away.
# So: ignore everything, then allow the tool itself.

*

# --- the tool ---
!.gitignore
!README.md
!watch.py
!enrich.py
!tailor.py
!applied.py
!open_apps.py
!run_watch.bat
!sort_applied.py
!check_resumes.py

# --- document export (Windows-only: these drive Word via COM) ---
!export_pdf.ps1
!make_web_assets.py
!make_resume_html.py

# --- reference data ---
!faang_plus.json

# --- templates (copy these, then fill them in) ---
!config.example.json
!resume_data.example.json

# --- tests and CI ---
# The directory entries come first: `*` above excludes directories too, and
# git will not descend into an excluded directory to find un-ignored files.
!tests/
!tests/*.py
!pytest.ini
!ruff.toml
!requirements-dev.txt
!.github/
!.github/workflows/
!.github/workflows/*.yml
